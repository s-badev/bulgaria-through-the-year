{
  "name": "bulgaria-through-the-year",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Жива снимка на София: НДК и Витоша през денонощието, сезоните и времето.",
  "scripts": {
    "predev": "node tools/build-all.mjs --if-changed",
    "dev": "vite --port 8080 --strictPort",
    "prebuild": "node tools/build-all.mjs --if-changed",
    "build": "vite build",
    "preview": "vite preview --port 8080 --strictPort",
    "test": "node --test \"tests/unit/*.test.js\"",
    "assets": "node tools/build-all.mjs",
    "qa": "node tests/qa/run-grid.mjs && node tests/qa/behaviour.mjs && node tests/qa/sun-accuracy.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "webgl2",
    "living-photo",
    "sofia",
    "vitosha",
    "ndk",
    "vite",
    "canvas"
  ]
}
